[Unit]
Description=vpsm Caddy (Reality fallback + subscription server)
After=network-online.target
Wants=network-online.target

[Service]
User=vpsm
Group=vpsm
Environment=XDG_DATA_HOME=@ROOT@/caddy/data
Environment=XDG_CONFIG_HOME=@ROOT@/caddy/config
Environment=GOMEMLIMIT=64MiB
ExecStart=@ROOT@/bin/caddy run --config @ROOT@/caddy/Caddyfile --adapter caddyfile
ExecReload=@ROOT@/bin/caddy reload --config @ROOT@/caddy/Caddyfile --adapter caddyfile --force
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@ROOT@/caddy
Restart=on-failure
RestartSec=3
LimitNOFILE=51200
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
