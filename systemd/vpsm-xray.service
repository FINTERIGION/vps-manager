[Unit]
Description=vpsm Xray (VLESS+Reality+Vision)
After=network-online.target
Wants=network-online.target

[Service]
User=vpsm
Group=vpsm
Environment=XRAY_LOCATION_ASSET=@ROOT@/bin
Environment=GOMEMLIMIT=128MiB
ExecStart=@ROOT@/bin/xray run -config @ROOT@/config.json
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure
RestartSec=3
LimitNOFILE=51200

[Install]
WantedBy=multi-user.target
